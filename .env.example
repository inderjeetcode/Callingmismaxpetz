# Max PetZ Hospitals — Call Analytics Dashboard
# Environment Configuration Template

# Server Port
PORT=3000

# Google Sheets Configuration
GOOGLE_SPREADSHEET_ID="170_JWT44cFX0QIvJ62KeLqe9io3hTkuNYJosVs2oCBA"
GOOGLE_SHEET_TAB="Main data"

# Google Service Account Credentials (JSON string with client_email and private_key)
# How to use: Create a Service Account in Google Cloud Console, download the JSON key,
# and share your Google Spreadsheet with the service account client_email with "Viewer" access.
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Alternative 1: Google Sheets API Key
GOOGLE_SHEETS_API_KEY=""

# Alternative 2: Google Apps Script Web App URL
GOOGLE_APPS_SCRIPT_URL=""

# APP_URL: Runtime hosting URL
APP_URL="http://localhost:3000"
